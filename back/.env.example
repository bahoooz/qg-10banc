# =============================================================================
# QG 10banc — Backend (.env)
# Copier vers back/.env et remplir les valeurs.
# =============================================================================

# --- Serveur ---
NODE_ENV=production
PORT=4000
# URL publique de l'API (cloudflared) — utilisée pour clips, OAuth callbacks, cron
API_URL=https://api.10banc.com
# URL publique du frontend — redirects OAuth après connexion
FRONTEND_URL=https://10banc.com
# Origines CORS supplémentaires (séparées par des virgules)
# CORS_ORIGINS=https://10banc.com,https://www.10banc.com,https://video.10banc.com

# --- Base de données (PostgreSQL natif sur le serveur) ---
DATABASE_URL=postgresql://qg_user:MOT_DE_PASSE@127.0.0.1:5432/qg_10banc

# --- Auth ---
JWT_SECRET=generer_une_cle_longue_aleatoire
GATEKEEPER_PASSWORD=mot_de_passe_gatekeeper

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx

# --- Éditeur de clips — transcription Whisper via Groq ---
GROQ_API_KEY=gsk_xxxxxxxx

# --- TikTok OAuth + publication ---
TIKTOK_CLIENT_KEY=xxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxx
TIKTOK_REDIRECT_URI=https://api.10banc.com/tiktok/auth/callback
TIKTOK_SCOPES=user.info.basic,video.upload

# --- YouTube OAuth ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=https://api.10banc.com/youtube/auth/callback

# --- Twitch OAuth (import clips) ---
TWITCH_CLIENT_ID=xxxxxxxx
TWITCH_CLIENT_SECRET=xxxxxxxx
TWITCH_REDIRECT_URI=https://api.10banc.com/twitch/auth/callback

# --- Génération vidéo Veo3 (optionnel — Vertex AI) ---
GCP_ID=your-gcp-project-id
GCS_BUCKET=gs://your-bucket
GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/vers/service-account.json

# --- Médias Veo3 (optionnel) ---
# MEDIA_BASE_URL=https://api.10banc.com/media

# --- Debug clips (optionnel) ---
# CLIP_DEBUG=false

# --- Chemins (optionnel — auto-détectés si absent) ---
# Racine monorepo si structure non standard
# MONOREPO_ROOT=/home/bahoz/apps/qg-10banc
# Build Vite du frontend (défaut: <monorepo>/front/dist)
# FRONT_DIST_DIR=/home/bahoz/apps/qg-10banc/front/dist

# --- Soundboard Voicy (optionnel — même lib que StreamLadder, 500k+ sons meme) ---
# Demander une clé sur https://www.voicy.network/products/sdk
# VOICY_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

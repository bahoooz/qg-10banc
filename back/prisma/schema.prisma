generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id          Int      @id @default(autoincrement())
  type        String   @default("tiktok")
  operationId String   @unique
  done        Boolean  @default(false)
  isPosted    Boolean? @default(false)
  prompt      String
  uri         String?  @unique
  url_link    String?  @unique
  createdAt   DateTime @default(now())
}

model Prompt {
  id               Int      @id @default(autoincrement())
  prompt           String
  intro            String   @default("Génère une grand-mère française de 100 ans")
  place            String
  habit            String
  rapSpeed         String   @default("fastNervous")
  animal           String?
  rapText          String
  instrumentalFlow String   @default("nervous")
  updatedAt        DateTime @default(now()) @updatedAt
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String   @unique
  avatar         String   @default("https://yt3.googleusercontent.com/9qweSKfHjyIVM8X62WGaqGEYNWgslObShwJ44EmrxZ7x3aMcUddClXrOyE2c0K50gnEKyVGD2kE=s160-c-k-c0x00ffffff-no-rj")
  hashedPassword String
  role           Role     @default(MODERATOR)
  lastActiveAt   DateTime
  updatedAt      DateTime @default(now()) @updatedAt
  createdAt      DateTime @default(now())
  createdNotes   Note[]         @relation("NoteAuthor") // Notes crées par le user
  memberOfNotes  Note[]         @relation("NoteMembers") // Notes où le user est concerné
  clipTemplates  ClipTemplate[]
  savedClips     SavedClip[]
}

model Note {
  id             Int      @id @default(autoincrement())
  title          String   @unique
  slug           String   @unique
  authorId       Int
  author         User     @relation("NoteAuthor", fields: [authorId], references: [id])
  members        User[]   @relation("NoteMembers")
  emoji          String
  pin            Boolean  @default(false)
  mentionMembers Boolean  @default(true)
  content        Json
  updatedAt      DateTime @default(now()) @updatedAt
  createdAt      DateTime @default(now())
}

model YouTubeAccount {
  id           String      @id @default(uuid())
  channelId    String      @unique // youtube ID
  title        String?
  description  String?
  avatar       String?
  customUrl    String?
  refreshToken String // Auth
  stats        DailyStat[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TikTokAccount {
  id           String      @id @default(uuid())
  openId       String      @unique // id tiktok
  username     String?
  displayName  String?
  avatar       String?
  accessToken  String // Expire en 24h
  refreshToken String // Expire en 1 an
  expiresIn    Int // Durée de validité en secondes (souvent 86400 -> 24h)
  stats        DailyStat[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TwitchAccount {
  id           String   @id @default(uuid())
  twitchUserId String   @unique
  login        String
  displayName  String?
  avatar       String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailyStat {
  id               String          @id @default(uuid())
  date             DateTime
  views            Int             @default(0)
  followers        Int             @default(0)
  likes            Int             @default(0)
  comments         Int?            @default(0)
  shares           Int?            @default(0)
  youtubeAccountId String?
  youtubeAccount   YouTubeAccount? @relation(fields: [youtubeAccountId], references: [id], onDelete: Cascade)
  tikTokAccountId  String?
  tikTokAccount    TikTokAccount?  @relation(fields: [tikTokAccountId], references: [id], onDelete: Cascade)

  @@unique([youtubeAccountId, date])
  @@unique([tikTokAccountId, date])
}

enum Role {
  MODERATOR
  ADMIN
}

model ClipTemplate {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model SavedClip {
  id             String   @id @default(uuid())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  clipId         String
  sourceType     String
  originalName   String?
  sourceWidth    Int
  sourceHeight   Int
  sourceDuration Float
  editorState    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([clipId])
  @@index([createdAt])
}

model Log {
  id String @id @default(cuid())
}

model MarkerStreamer {
  id           String          @id
  name         String
  twitchLogin  String          @map("twitch_login")
  twitchUserId String?         @map("twitch_user_id")
  active       Boolean         @default(true)
  sessions     StreamSession[]
  markers      StreamMarker[]

  @@map("streamers")
}

model StreamSession {
  id             String         @id @default(uuid())
  streamerId     String         @map("streamer_id")
  streamer       MarkerStreamer @relation(fields: [streamerId], references: [id])
  twitchStreamId String         @unique @map("twitch_stream_id")
  title          String?
  startedAt      DateTime       @map("started_at")
  endedAt        DateTime?      @map("ended_at")
  vodVideoId     String?        @map("vod_video_id")
  vodUrl         String?        @map("vod_url")
  markers        StreamMarker[]

  @@index([streamerId, startedAt(sort: Desc)])
  @@map("stream_sessions")
}

model StreamMarker {
  id                String          @id
  streamerId        String          @map("streamer_id")
  streamer          MarkerStreamer  @relation(fields: [streamerId], references: [id])
  sessionId         String?         @map("session_id")
  session           StreamSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  pressedAt         DateTime        @map("pressed_at")
  obsStreamOffsetMs BigInt          @map("obs_stream_offset_ms")
  obsTimecode       String?         @map("obs_timecode")
  obsScene          String?         @map("obs_scene")
  windowBeforeMs    Int             @map("window_before_ms")
  windowAfterMs     Int             @map("window_after_ms")
  thumbnailPath     String?         @map("thumbnail_path")
  clientVersion     String?         @map("client_version")
  vodOffsetSeconds  Int?            @map("vod_offset_seconds")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([sessionId, obsStreamOffsetMs])
  @@index([streamerId, pressedAt(sort: Desc)])
  @@map("markers")
}

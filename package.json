{
  "name": "qg-10banc",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter qg-back dev",
    "dev:back": "pnpm --filter qg-back dev",
    "dev:front": "pnpm --filter qg-front dev",
    "build": "pnpm build:back && pnpm build:front",
    "build:back": "pnpm --filter qg-back exec tsc -p ../packages/subtitle-composition/tsconfig.json && pnpm --filter qg-back build",
    "build:front": "pnpm --filter qg-front build",
    "start:back": "pnpm --filter qg-back start:prod",
    "db:generate": "pnpm --filter qg-back db:generate",
    "db:migrate": "pnpm --filter qg-back db:migrate",
    "typecheck": "pnpm --filter qg-back exec tsc -p tsconfig.json --noEmit && pnpm --filter qg-front exec tsc -b --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/canvas",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
